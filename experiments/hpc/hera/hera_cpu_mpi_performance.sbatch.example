#!/bin/bash
#SBATCH --job-name=dlmmc-hera-perf
#SBATCH --account=chimera
#SBATCH --partition=hera
#SBATCH --qos=batch
#SBATCH --nodes=1
#SBATCH --ntasks=3
#SBATCH --cpus-per-task=1
#SBATCH --time=06:00:00
#SBATCH --output=/scratch3/BMC/chimera/Sean.M.Davis/dlmmc-work/dlmmc-hera-perf-%j.out
#SBATCH --error=/scratch3/BMC/chimera/Sean.M.Davis/dlmmc-work/dlmmc-hera-perf-%j.err

# Override per configuration from the submit command; sbatch exports the
# environment (PERF_CELL_INDICES, CHAINS, PARALLEL_CHAINS, WARMUP, SAMPLES,
# SEED, NO_PROGRESS=1), and command-line options override #SBATCH defaults, e.g.
#   PERF_CELL_INDICES="0" PARALLEL_CHAINS=2 sbatch --ntasks=5 --cpus-per-task=2 <this file>
set -euo pipefail

REPO_ROOT="${SLURM_SUBMIT_DIR}"
WORK_ROOT="/scratch3/BMC/chimera/Sean.M.Davis/dlmmc-work"
CONDA_BASE="/home/Sean.M.Davis/miniforge3"
CONDA_ENV="${CONDA_BASE}/envs/dlmmc-hera"
INTEL_MODULE_VERSION="2024.2.1"
IMPI_MODULE_VERSION="2024.2.1"

# Keep this same ordered set of valid flat pressure/latitude IDs in every run.
read -r -a CELL_INDICES <<< "${PERF_CELL_INDICES:-0 22 43 65 86 108 129 151 172 194 215 237 258 280 301 323}"
CHAINS="${CHAINS:-4}"
PARALLEL_CHAINS="${PARALLEL_CHAINS:-1}"
WARMUP="${WARMUP:-500}"
SAMPLES="${SAMPLES:-500}"
SEED="${SEED:-20261104}"
NO_PROGRESS="${NO_PROGRESS:-0}"
PROGRESS_ARGS=()
if [[ "${NO_PROGRESS}" == 1 ]]; then PROGRESS_ARGS=(--no-progress); fi

if (( PARALLEL_CHAINS < 1 || PARALLEL_CHAINS > CHAINS || PARALLEL_CHAINS > SLURM_CPUS_PER_TASK )); then
    echo "PARALLEL_CHAINS must not exceed CHAINS or the CPUs allocated per task." >&2
    exit 1
fi

: "${LMOD_CMD:?Initialize HERA Lmod before loading modules}"
source "$(dirname "${LMOD_CMD}")/../init/bash"
module load "intel/${INTEL_MODULE_VERSION}" "impi/${IMPI_MODULE_VERSION}"
module list 2>&1

source "${CONDA_BASE}/etc/profile.d/conda.sh"
# Conda activation hooks may reference unset variables.
set +u
conda activate "${CONDA_ENV}"
set -u
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
HERA_SLURM_MPI="${HERA_SLURM_MPI-pmi2}"

run_mpi() {
    if [[ -n "${HERA_SLURM_MPI:-}" ]]; then
        srun --mpi="${HERA_SLURM_MPI}" \
            --ntasks="${SLURM_NTASKS}" \
            --cpus-per-task="${SLURM_CPUS_PER_TASK}" "$@"
    else
        srun --ntasks="${SLURM_NTASKS}" \
            --cpus-per-task="${SLURM_CPUS_PER_TASK}" "$@"
    fi
}

RUN_DIR="${WORK_ROOT}/runs/${SLURM_JOB_ID}"
CACHE_DIR="${WORK_ROOT}/cmdstan-cache"
export TMPDIR="${WORK_ROOT}/tmp/${SLURM_JOB_ID}"
mkdir -p "${RUN_DIR}" "${CACHE_DIR}" "${TMPDIR}"
export OUTPUT_FILE="${RUN_DIR}/hera-mpi-perf.nc"
cd "${REPO_ROOT}"

{
    echo "job_id=${SLURM_JOB_ID}"
    echo "git_commit=$(git rev-parse HEAD)"
    echo "git_status:"
    git status --short
    echo "nodes=${SLURM_JOB_NUM_NODES}"
    echo "ntasks=${SLURM_NTASKS}"
    echo "cpus_per_task=${SLURM_CPUS_PER_TASK}"
    echo "cell_indices=${CELL_INDICES[*]}"
    echo "model=vanilla_ar1"
    echo "chains=${CHAINS}"
    echo "parallel_chains=${PARALLEL_CHAINS}"
    echo "warmup=${WARMUP}"
    echo "samples=${SAMPLES}"
    echo "seed=${SEED}"
    echo "no_progress=${NO_PROGRESS}"
    echo "srun_mpi_plugin=${HERA_SLURM_MPI:-site-default}"
    echo "tmpdir=${TMPDIR}"
    echo "work_root=${WORK_ROOT}"
    echo "cache_dir=${CACHE_DIR}"
    echo "module_list:"
    module list 2>&1
    echo "srun_mpi_plugins:"
    srun --mpi=list 2>&1
    python -c 'import cmdstanpy, mpi4py, numpy, pandas, sys, xarray; mpi4py.rc.initialize=False; from mpi4py import MPI; print("python", sys.version); print("cmdstanpy", cmdstanpy.__version__); print("cmdstan_path", cmdstanpy.cmdstan_path()); print("cmdstan_version", cmdstanpy.cmdstan_version()); print("mpi4py", mpi4py.__version__); print("mpi_library", MPI.Get_library_version()); print("numpy", numpy.__version__); print("pandas", pandas.__version__); print("xarray", xarray.__version__)'
} > "${RUN_DIR}/run-metadata.txt"

run_mpi python experiments/hpc/check_mpi.py
run_mpi python -u dlm_lat_alt_mpi_run.py \
    --output "${OUTPUT_FILE}" \
    --cell-indices "${CELL_INDICES[@]}" \
    --chains "${CHAINS}" \
    --parallel-chains "${PARALLEL_CHAINS}" \
    --warmup "${WARMUP}" \
    --samples "${SAMPLES}" \
    --seed "${SEED}" \
    --cache-dir "${CACHE_DIR}" \
    "${PROGRESS_ARGS[@]}"

python experiments/hpc/check_fit_status.py "${OUTPUT_FILE}" "${CELL_INDICES[@]}"

stat --printf='output_bytes=%s\n' "${OUTPUT_FILE}"
echo "run_directory=${RUN_DIR}"
