#!/bin/bash
#SBATCH --job-name=dlmmc-hera-smoke
#SBATCH --account=REPLACE_WITH_PROJECT
#SBATCH --partition=hera
#SBATCH --qos=debug
#SBATCH --nodes=1
#SBATCH --ntasks=3
#SBATCH --cpus-per-task=1
#SBATCH --time=00:20:00
#SBATCH --output=dlmmc-hera-%j.out
#SBATCH --error=dlmmc-hera-%j.err

# Template only: verify every placeholder, account/QOS limit, module version,
# MPI plugin, and storage path on the live HERA system before submission.
set -euo pipefail

REPO_ROOT="${SLURM_SUBMIT_DIR}"
WORK_ROOT="/REPLACE/WITH/PROJECT/WORK/dlmmc"
CONDA_BASE="/REPLACE/WITH/PROJECT/HOME/miniforge3"
CONDA_ENV="${CONDA_BASE}/envs/dlmmc-hera"
INTEL_MODULE_VERSION="REPLACE_WITH_VERIFIED_VERSION"
IMPI_MODULE_VERSION="REPLACE_WITH_VERIFIED_VERSION"

# HERA documents Intel MPI and MVAPICH2. Start with one site-supported stack;
# mpi4py must be built against the same MPI library used by srun.
: "${MODULESHOME:?Initialize the HERA module system before loading modules}"
source "${MODULESHOME}/init/bash"
module load "intel/${INTEL_MODULE_VERSION}" "impi/${IMPI_MODULE_VERSION}"
module list 2>&1

source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV}"
export PYTHONUNBUFFERED=1

# Set HERA_SLURM_MPI only to a value verified with `srun --mpi=list` and the
# selected site MPI stack. Empty uses the site's default srun MPI plugin.
run_mpi() {
    if [[ -n "${HERA_SLURM_MPI:-}" ]]; then
        srun --mpi="${HERA_SLURM_MPI}" \
            --ntasks="${SLURM_NTASKS}" \
            --cpus-per-task="${SLURM_CPUS_PER_TASK}" "$@"
    else
        srun --ntasks="${SLURM_NTASKS}" \
            --cpus-per-task="${SLURM_CPUS_PER_TASK}" "$@"
    fi
}

# Store caches, logs, and outputs in approved project Work. TMPDIR is local to
# this single node; make it explicitly on the node before launching the ranks.
RUN_DIR="${WORK_ROOT}/runs/${SLURM_JOB_ID}"
CACHE_DIR="${WORK_ROOT}/cmdstan-cache"
export TMPDIR="${SLURM_TMPDIR:-/tmp}/${USER}/dlmmc-${SLURM_JOB_ID}"
mkdir -p "${RUN_DIR}" "${CACHE_DIR}" "${TMPDIR}"
export OUTPUT_FILE="${RUN_DIR}/hera-mpi-smoke.nc"
cd "${REPO_ROOT}"

# Confirm the imported mpi4py is linked to the loaded HERA MPI.
python -c 'from mpi4py import MPI; print(MPI.Get_library_version())'
run_mpi \
    python -c 'from mpi4py import MPI; c=MPI.COMM_WORLD; print(f"rank={c.rank} size={c.size} sum={c.allreduce(1)}")'

# Pipeline smoke only: rank 0 writes; two workers fit two cells serially.
run_mpi \
    python -u dlm_lat_alt_mpi_run.py \
    --output "${OUTPUT_FILE}" \
    --cell-indices 0 160 \
    --chains 1 --parallel-chains 1 --warmup 1 --samples 2 --seed 20261103 \
    --cache-dir "${CACHE_DIR}"

python -c 'import os, numpy as np, xarray as xr; d=xr.open_dataset(os.environ["OUTPUT_FILE"]); print(dict(zip(*np.unique(d.fit_status.values, return_counts=True)))); assert np.all(d.fit_status.values == 1)'
