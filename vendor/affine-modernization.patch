+++ b/tests/test_torch_stream.py
@@ -0,0 +1,57 @@
+import numpy as np
+import pytest
+import torch
+from affine.torch import sample,sample_batch
+from affine.torch_stream import initialize,advance,save_state,load_state
+
+
+@pytest.mark.parametrize('batch',[False,True])
+@pytest.mark.parametrize('dtype',[torch.float32,torch.float64])
+def test_exact_stock_transitions_and_unstored_checkpoint(tmp_path,batch,dtype):
+    def target(x):return -.5*(x*x).sum(-1),torch.cat([x,x*x],-1)
+    gen=torch.Generator().manual_seed(101)
+    shape=(8,3,2) if batch else (8,2)
+    halves=tuple(torch.randn(shape,dtype=dtype,generator=gen) for _ in range(2))
+    torch.manual_seed(91)
+    expected=(sample_batch if batch else sample)(target,32,halves,n_burnin=6,thin=3,
+        progress=False,save_lp=True,save_extras=True)
+    state=initialize(target,halves,seed=91,warmup=5,thin=3,save_extras=True,provenance='fixed')
+    caller=torch.get_rng_state().clone()
+    state,a,la,ea,sa=advance(target,state,14)
+    assert torch.equal(caller,torch.get_rng_state())
+    assert state.iteration==14 and sa[-1]==12  # terminal state is not stored
+    save_state(tmp_path/'state.npz',state)
+    restored=load_state(tmp_path/'state.npz',provenance='fixed')
+    state,b,lb,eb,sb=advance(target,restored,17)
+    for actual,reference in zip((torch.cat([a,b]),torch.cat([la,lb]),torch.cat([ea,eb])),expected):
+        assert torch.equal(actual,reference)
+    assert np.array_equal(np.concatenate([sa,sb]),np.arange(6,32,3))
+    assert bool((state.proposed==26).all() and (state.warmup_proposed==5).all())
+    assert bool((state.accepted<=state.proposed).all())
+
+
+def test_actual_acceptance_counters_include_identical_accepted_points():
+    # Degenerate halves deliberately test counters, not a valid initialization
+    # for scientific inference: every d=1 stretch move accepts identical zeros.
+    halves=(torch.zeros(4,1),torch.zeros(4,1))
+    s=initialize(lambda x:torch.zeros(x.shape[:-1]),halves,seed=1,warmup=2)
+    s,x,*_=advance(lambda x:torch.zeros(x.shape[:-1]),s,7)
+    assert bool((s.accepted==5).all() and (s.warmup_accepted==2).all())
+    assert bool((x==0).all())
+
+
+def test_malformed_callback_and_initial_support_rejected():
+    h=(torch.zeros(4,2),torch.zeros(4,2))
+    with pytest.raises(ValueError):initialize(lambda x:torch.zeros(4,1),h,seed=1)
+    with pytest.raises(ValueError):initialize(lambda x:torch.full((4,),-torch.inf),h,seed=1)
+    with pytest.raises(FloatingPointError):initialize(lambda x:torch.full((4,),torch.nan),h,seed=1)
+    with pytest.raises(ValueError):initialize(lambda x:torch.zeros(4,dtype=torch.float64),h,seed=1)
+
+
+def test_empty_retained_chunk_and_target_identity(tmp_path):
+    h=(torch.ones(4,2),torch.ones(4,2))
+    s=initialize(lambda x:-x.square().sum(-1),h,seed=4,warmup=10,provenance='A')
+    s,x,lp,e,steps=advance(lambda x:-x.square().sum(-1),s,3)
+    assert x.shape==(0,8,2) and lp.shape==(0,8) and e is None and len(steps)==0
+    save_state(tmp_path/'state.npz',s)
+    with pytest.raises(ValueError):load_state(tmp_path/'state.npz',provenance='B')
